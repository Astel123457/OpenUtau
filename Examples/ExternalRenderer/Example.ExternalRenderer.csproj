<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenUtauCoreProject Condition="'$(OpenUtauCoreProject)' == '' and '$(OpenUtauCorePath)' == ''">..\..\OpenUtau.Core\OpenUtau.Core.csproj</OpenUtauCoreProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenUtauCorePath)' == ''">
    <ProjectReference Include="$(OpenUtauCoreProject)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(OpenUtauCorePath)' != ''">
    <Reference Include="OpenUtau.Core" HintPath="$(OpenUtauCorePath)" Private="false" />
  </ItemGroup>
</Project>
